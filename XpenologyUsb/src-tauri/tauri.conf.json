{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xpenologyusb",
  "version": "0.4.5",
  "identifier": "com.svrforum.xpenologyusb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Xpenology USB",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "svrforum",
    "copyright": "Copyright (c) 2026 svrforum. MIT License.",
    "category": "Utility",
    "shortDescription": "Xpenology 부트로더를 USB에 굽는 프로그램",
    "longDescription": "Writes Xpenology bootloader images (m-shell / RR) to a USB drive. Open source, MIT licensed, built from source by GitHub Actions. https://github.com/svrforum/SFTool",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
